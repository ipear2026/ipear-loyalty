# ═══════════════════════════════════════════
#  iPear Loyalty — .gitignore
# ═══════════════════════════════════════════

# Dependencies
node_modules/
functions/node_modules/

# Environment / Secrets
.env
.env.*
# LOW-1: template (placeholders only) — tracked for contributors
!.env.example
.dev.vars
*.pem
*.key
credentials*.json
service-account*.json

# Firebase
.firebase/
firebase-debug.log
firebase-debug.err

# Cloudflare
.wrangler/

# OS
.DS_Store
Thumbs.db

# macOS Finder "Duplicate" copies (filename 2.ext, dirname 2/) — never ship.
# Audit MEDIUM-1 / cleanup: prevents Finder Cmd+D from accidentally committing
# stale forks of source files (e.g. functions/index 2.js with old logic).
* 2.js
* 2.json
* 2.mjs
* 2.cjs
* 2.ts
* 2.css
* 2.html
* 2/

# IDE / Local tooling
.vscode/
.idea/
.claude/

# Logs
*.log

# Build artifacts / Zips
dist/
*.zip
*.tmp.js
*.bak

# Playwright artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# Ad-hoc probe / debug scripts (security-probe, legacy-probe, etc.)
/tmp/

{
  "name": "ipear-loyalty-customer",
  "version": "54.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate-env.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src email-worker.js public/sw-customer.js public/sw.js public/firebase-messaging-sw.js tests vitest.config.js",
    "lint:fix": "eslint --fix src",
    "test": "vitest run --exclude tests/firestore-rules.test.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project=loyalty-ipear-test 'vitest run tests/firestore-rules.test.js'",
    "validate:env": "node scripts/validate-env.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:seed": "node scripts/seed-e2e-customer.js",
    "deploy:pages": "npm run build && (cd dist && wrangler pages deploy . --project-name=ipear-loyalty --branch=main --commit-dirty=true)",
    "format": "prettier --write \"src/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.61.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.18.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "vite": "^6.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "firebase": "^10.14.1"
  },
  "overrides": {
    "undici": "^7.16.0"
  }
}

{
  "name": "ipear-loyalty-customer",
  "version": "54.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src email-worker.js public/sw-customer.js public/sw.js public/firebase-messaging-sw.js tests vitest.config.js",
    "lint:fix": "eslint --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy:pages": "npm run build && (cd dist && wrangler pages deploy . --project-name=ipear-loyalty --branch=main --commit-dirty=true)",
    "format": "prettier --write \"src/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "vite": "^6.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "firebase": "^10.14.1"
  },
  "overrides": {
    "undici": "^7.16.0"
  }
}

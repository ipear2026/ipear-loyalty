# ═══════════════════════════════════════════════════════════════════════════
#  iPear Loyalty — Environment Template
#
#  Copy this file to `.env` and fill in real values. Every VITE_* key listed
#  below is PUBLIC client-side configuration (it ships in the JS bundle); the
#  app's defence model relies on Firestore rules + App Check, NOT on these
#  keys being secret.
#
#  LOW-1: this file is committed to git. Do NOT put real production keys here
#  — keep them in `.env` (which is .gitignored). The placeholders below are
#  enough to let `npm run build` succeed in CI.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Firebase (public client-side config) ────────────────────
# Find these at:  Firebase Console → Project Settings → Your apps → Web
VITE_FB_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_MSG_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:0000000000000000000000

# ─── Firebase Cloud Messaging (web push) ─────────────────────
# Find at:  Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FCM_VAPID_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Firebase App Check (reCAPTCHA v3 site key) ──────────────
# Find at:  Firebase Console → App Check → Apps → Web App → reCAPTCHA v3 site key
VITE_APP_CHECK_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Cloudflare Worker (telemetry / email / SMS / FCM) ───────
# Should be your CUSTOM domain (cached + WAF-protected), NOT the raw
# *.workers.dev URL. Only use the workers.dev URL for local dev.
VITE_WORKER_URL=https://worker.example.com

# ─── E2E (Playwright golden-path) — locally only, never commit values ─
# Required when running `npm run e2e` against real Firebase. In CI these
# come from GitHub Actions secrets (see .github/workflows/ci.yml → e2e job).
#   TEST_EMAIL                    — dedicated e2e customer account
#   TEST_PASS                     — its password
#   FIREBASE_SERVICE_ACCOUNT_JSON — base64(JSON) of a service account with
#                                   Firestore read/write. Generate via:
#                                     base64 -w0 service-account.json
#   E2E_BASE_URL                  — optional; if set, skips local vite preview
#                                   and runs against the URL (use a preview
#                                   deploy URL to validate before promote).
TEST_EMAIL=e2e@ipear.test
TEST_PASS=replace-me
FIREBASE_SERVICE_ACCOUNT_JSON=base64-of-service-account-json
